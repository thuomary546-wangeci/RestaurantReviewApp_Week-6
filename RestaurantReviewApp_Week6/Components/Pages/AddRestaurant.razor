@page "/restaurants/add"
@inject FakeRestaurantService RestaurantService
@inject NavigationManager Navigation

<PageTitle>Add Restaurant</PageTitle>

<h1>Add Restaurant</h1>
<p>Use this form to add a restaurant to the fake data set.</p>

<EditForm Model="newRestaurant"
 OnValidSubmit="HandleAdd"
 FormName="AddRestaurantForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Restaurant Name</label>
        <InputText class="input" @bind-Value="newRestaurant.Name" />
    </div>

    <div class="form-group">
        <label>Location</label>
        <InputText class="input" @bind-Value="newRestaurant.Location" />
    </div>

    <div class="form-group">
        <label>Cuisine Type</label>
        <InputText class="input" @bind-Value="newRestaurant.CuisineType" />
    </div>

    <div class="form-group">
        <label>Rating</label>
        <InputNumber class="input" @bind-Value="newRestaurant.Rating" />
    </div>

    <button class="button" type="submit">Add Restaurant</button>
    <a class="button secondary" href="/restaurants">Cancel</a>
</EditForm>

@code {
    private Restaurant newRestaurant = new();

    private void HandleAdd()
    {
        RestaurantService.Add(newRestaurant);
        Navigation.NavigateTo("/restaurants");
    }
}
